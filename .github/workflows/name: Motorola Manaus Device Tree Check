
name: Motorola Manaus Device Tree Check

on:
  workflow_dispatch:

jobs:
  device:
    runs-on: ubuntu-latest
    steps:
      - name: Clone device tree
        run: |
          git clone --depth=1 \
            -b device_motorola_manaus \
            https://github.com/RyannBreston/device_motorola_manaus.git \
            device

      - name: Inspect device tree
        run: |
          cd device
          echo "===== FILES ====="
          ls -la
          echo "===== PRODUCT FILES ====="
          find . -maxdepth 3 \
            -type f \( -name "*.mk" -o -name "*.bp" -o -name "*.xml" \)
          echo "===== README ====="
          cat README.md
